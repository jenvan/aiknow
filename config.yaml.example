# AiKnow L1 启动配置示例
#
# 复制为 config.yaml 后修改。config.yaml 已在 .gitignore 中，不会被提交。
#
# 优先级：环境变量 > .env > config.yaml > 内置默认值
#   —— 同一项在多处出现时，取优先级最高的来源。
#
# 本文件只包含 **L1 启动配置**（进程启动时读取，改动需重启）。
# 检索权重、分块大小、LLM 温度等 **L2 业务配置** 存放在数据库 settings 表中，
# 由后台管理界面调整并热生效，不在此处配置。
#
# 注意：本文件列出的字段就是代码实际读取的全部字段。
# 若新增字段，需同时在 internal/config/config.go 的 YAMLConfig 与 managedKeys 中登记，
# 否则不会生效（config_test.go 中的 TestExampleYAMLMatchesParser 会守住这一致性）。

# 数据库
#
# url 与下方分项二选一：填了 url 就忽略分项。
database:
  # 完整连接串。格式: postgres://user:password@host:port/database?sslmode=disable
  # 对应环境变量 DATABASE_URL
  url: "postgres://postgres:password@127.0.0.1:5432/aiknow?sslmode=disable"

  # 分项（url 为空时用于拼装连接串）。
  # 密码会做 URL 编码，含 @ : / ? # 等特殊字符也无需手动转义。
  # 对应环境变量 POSTGRES_HOST / POSTGRES_PORT / POSTGRES_USER /
  #              POSTGRES_PASSWORD / POSTGRES_DB / POSTGRES_SSLMODE
  host: ""          # 默认 postgres（docker compose 服务名）
  port: 0           # 0 表示未设置，取默认 5432
  user: ""          # 默认 postgres
  password: ""
  name: ""          # 默认 aiknow
  sslmode: ""       # 默认 disable

# HTTP 服务器
server:
  # 监听端口，对应环境变量 PORT
  port: 8080

# 运行环境
app:
  # development | production
  # 对应环境变量 APP_ENV。设为 production 时：
  #   - 禁止使用明文 admin.password，必须提供 password_hash
  #   - Session Cookie 启用 Secure 标记（仅 HTTPS 传输）
  env: "development"

# Session（后台管理鉴权）
session:
  # 签名密钥，至少 32 个字符，生产环境务必改为随机串
  # 对应环境变量 SESSION_SECRET
  secret: "change-me-to-a-random-string-at-least-32-chars"
  # Session 有效期，同时作为 Cookie 的 MaxAge
  # 对应环境变量 SESSION_LIFETIME
  lifetime: "24h"

# 管理员账号
#
# password_hash 与 password 至少提供一个；两者都有时以 password_hash 为准。
admin:
  # 对应环境变量 ADMIN_USERNAME
  username: "admin"
  # bcrypt 哈希，用 `aiknow-server hashpwd 你的密码` 生成
  # 对应环境变量 ADMIN_PASSWORD_HASH
  password_hash: ""
  # 明文密码，仅开发环境可用（启动时在内存中哈希，不落盘）
  # 生产环境（app.env = production）填写此项会导致启动失败
  # 对应环境变量 ADMIN_PASSWORD
  password: ""

# AI Provider 选择
#
# 三者独立选择，缺省均为 mock（无需凭据，便于本地开发）。
# 选择 qwen / baai 时，下方对应的 api_key 必填，否则启动失败。
ai:
  # qwen | mock
  # 对应环境变量 LLM_PROVIDER
  llm_provider: "mock"
  # baai | mock
  # 对应环境变量 EMBEDDING_PROVIDER
  embedding_provider: "mock"
  # baai | mock
  # 对应环境变量 RERANKER_PROVIDER
  reranker_provider: "mock"

# 阿里云 Qwen（ai.llm_provider = qwen 时使用）
qwen:
  # 对应环境变量 QWEN_API_KEY。建议改用环境变量或 .env 提供，避免写入文件
  api_key: ""
  # 对应环境变量 QWEN_BASE_URL
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  # LLM 使用的模型名称，对应环境变量 QWEN_MODEL，默认 qwen-plus
  model: "qwen-plus"

# BAAI（ai.embedding_provider / reranker_provider = baai 时使用）
#
# Embedding 与 Reranker 共用同一组凭据。
baai:
  # 对应环境变量 BAAI_API_KEY。建议改用环境变量或 .env 提供
  api_key: ""
  # 对应环境变量 BAAI_BASE_URL，末尾不带 /v1（provider 内部拼路径）
  base_url: "https://api.deepinfra.com"
  # 对应环境变量 BAAI_EMBEDDING_MODEL，留空使用 BAAI/bge-large-zh-v1.5
  embedding_model: ""
  # 对应环境变量 BAAI_RERANKER_MODEL，留空使用 BAAI/bge-reranker-v2-m3
  reranker_model: ""

# 网页采集（抓取文章 URL 时的请求）
#
# 超时、重定向、最小内容长度属 L1 启动配置（http.Client 在启动时创建，
# 运行时修改需重启生效）。User-Agent 例外：后台「系统配置 → collector.user_agent」
# 可覆盖此值并热生效。
collector:
  # 抓取超时，对应环境变量 COLLECTOR_TIMEOUT，默认 10s
  timeout: "10s"
  # 最大重定向次数，对应环境变量 COLLECTOR_MAX_REDIRECTS，默认 3
  max_redirects: 3
  # 最小内容长度（字符），低于此长度视为采集失败，对应环境变量
  # COLLECTOR_MIN_CONTENT_LENGTH，默认 200
  min_content_length: 200
  # 抓取网页时发送的 User-Agent，对应环境变量 COLLECTOR_USER_AGENT，默认如下。
  # 后台「系统配置 → collector.user_agent」可覆盖此值并热生效。
  user_agent: "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1"

# 无头浏览器渲染（渲染优先，http 兜底）
#
# 渲染优先：需 enabled=true 且 endpoint 非空才真正走浏览器；否则采集退化为
# 纯 http，无需部署浏览器。浏览器独立部署（browserless），见 deploy/browserless/。
render:
  # 总开关。对应环境变量 COLLECTOR_BROWSER_ENABLED，默认 false
  enabled: false
  # browserless 端点，如 http://1.2.3.4:3000。
  # 对应环境变量 COLLECTOR_BROWSER_ENDPOINT，默认空（关闭渲染）
  endpoint: ""
  # browserless 访问令牌。对应环境变量 COLLECTOR_BROWSER_TOKEN
  token: ""
  # 单页渲染硬超时（含浏览器内导航、等待、截图全程）。对应环境变量
  # COLLECTOR_BROWSER_TIMEOUT，默认 30s。
  # 派生的子超时按此值缩放：导航 = 此值-2s；等网络空闲/等图片加载 = 此值/3（下限 3s）。
  # 调大此值会等比放宽各子超时，故长文/图片多的页面可适当调大（如 60s）。
  timeout: "30s"

# 腾讯云 COS（采集文章截图归档）
#
# URL 采集的文章在渲染时顺带截全页图，上传 COS 防止源站失效后无从回溯。
# 下列字段任一缺失则截图归档整体关闭（不影响正文采集）。
# 凭据建议用环境变量或 .env 提供，避免写入本文件。
cos:
  # 腾讯云 API 密钥，对应环境变量 COS_SECRET_ID / COS_SECRET_KEY
  secret_id: ""
  secret_key: ""
  # 存储桶名（含 appid 后缀），如 aiknow-1300000000。对应环境变量 COS_BUCKET
  bucket: ""
  # 地域，如 ap-guangzhou。对应环境变量 COS_REGION
  region: ""
  # 自定义访问域名（CDN）；留空用 COS 默认域名。对应环境变量 COS_ENDPOINT
  endpoint: ""
  # 对象键前缀，默认 screenshots。对应环境变量 COS_PATH_PREFIX
  path_prefix: "screenshots"

# ================================================================
# 以下配置项当前由代码固定，不通过本文件读取：
#
#   连接池      MaxConns=20 / MinConns=2 / 连接寿命 30m / 空闲 10m
#               见 internal/repository/postgres.go
#   HTTP 超时   Read/Write 15s / Idle 60s
#               见 cmd/aiknow-server/main.go
#   向量维度    1024（与 bge-large-zh-v1.5 绑定，不可改）
#
# 登录失败锁定（lockout_duration / max_failed_attempts）尚未实现，
# 故本文件不再列出这两项，避免误以为已生效。
# ================================================================
