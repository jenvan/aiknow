# AiKnow 环境变量配置示例
# 复制此文件为 .env 并填写实际值

# 数据库连接（必填）
DATABASE_URL=postgres://user:password@localhost:5432/aiknow?sslmode=disable

# AI 服务（必填）
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAAI_API_KEY=your_baai_api_key_here
BAAI_BASE_URL=https://api.deepinfra.com/v1

# 服务器配置
PORT=8080
APP_ENV=development

# 会话密钥（必填，32 字节以上随机串）
SESSION_SECRET=your_random_secret_key_at_least_32_characters_long

# 管理员账号（必填，二选一）
# 方式 1：密码哈希（推荐生产环境）
ADMIN_PASSWORD_HASH=$2a$10$XASjUxlArwXV/CZJsBLbpe3XCuiqvlRvyr7GZXkjG4wia1GeJYda.
# 方式 2：明文密码（仅开发环境）
# ADMIN_PASSWORD=admin123
