# AiKnow 环境配置示例
#
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
#
# 优先级：环境变量 > .env > config.yaml > 内置默认值
#
# 只列出确实生效的变量。L2 业务配置（检索权重、分块大小、LLM 温度等）
# 存放在数据库 settings 表中，由后台管理界面调整并热生效，不在此处配置。


# ================================================================
# 数据库连接
# ================================================================
#
# 两种方式，**二选一**：
#
#   方式 1  DATABASE_URL          —— 直跑二进制（本地开发 / 生产）
#   方式 2  POSTGRES_* 分项       —— docker compose
#
# DATABASE_URL 优先：填了它就忽略下面的分项。
#
# compose 部署下本文件里的 DATABASE_URL 会被编排显式置空（它通常指向
# 127.0.0.1，在容器内是容器自己），因此两者可以并存于同一份 .env，
# 各自在对应部署形态下生效，不会互相干扰。

# ---- 方式 1：直跑二进制 ----
# 注释掉或留空则改用下方分项
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/aiknow?sslmode=disable

# ---- 方式 2：docker compose ----
#
# compose 下这组值有两个用途：建库（postgres 服务），以及由应用拼装连接串。
# 主机名由编排固定为服务名 postgres，无需在此设置。
POSTGRES_USER=postgres
# 必填。compose 启动时未设置会直接报错
POSTGRES_PASSWORD=
POSTGRES_DB=aiknow

# 数据库端口。默认 5432。
#
# compose 下这是**宿主机发布端口**（供 psql、make db-init、客户端工具直连）；
# 容器网络内固定 5432，改这个值不影响 app 连接数据库。
# 宿主机 5432 已被占用时改这里，例如 POSTGRES_PORT=15432。
POSTGRES_PORT=5432

# 直跑二进制时若想改用分项（而非 DATABASE_URL），还需设置：
#   POSTGRES_HOST=127.0.0.1     默认 postgres（compose 服务名）
#   POSTGRES_SSLMODE=disable    默认 disable


# ================================================================
# 服务器
# ================================================================

# 应用监听端口（容器内端口 / 直跑时的本机端口）。默认 8080。
PORT=8080

# 运行环境：development | production。默认 development。
#
# 设为 production 时：
#   - 禁止使用明文 ADMIN_PASSWORD，必须提供 ADMIN_PASSWORD_HASH，否则启动失败
#   - Session Cookie 启用 Secure 标记（仅 HTTPS 传输）
#
# 注意：本地通过 HTTP 访问时不要设为 production，否则浏览器不会回传 Cookie，
#       将无法登录。
APP_ENV=development


# ================================================================
# 会话与管理员
# ================================================================

# Session 密钥，至少 32 个字符，生产环境务必改为随机串。
#
# 当前状态：配置校验会强制要求本项且检查长度，但代码尚未实际使用它
# （Session ID 由密码学随机源生成并在服务端存储，暂不需要签名密钥）。
# 保留为必填是为了在引入 CSRF Token / Cookie 签名前就把它准备好。
#
# 生成方式：openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Session 有效期，同时作为 Cookie 的 MaxAge。默认 24h。
# 格式为 Go 时长字符串：30m / 12h / 168h
SESSION_LIFETIME=24h

# 管理员用户名。默认 admin。
ADMIN_USERNAME=admin

# 管理员密码，以下两项**至少提供一个**；同时存在时以 HASH 为准。

# 方式 1：bcrypt 哈希（生产环境必须用这个）
# 生成命令：go run ./cmd/aiknow-server hashpwd 你的密码
ADMIN_PASSWORD_HASH=

# 方式 2：明文密码（仅开发环境；启动时在内存中哈希，不落盘）
# APP_ENV=production 时填写此项会导致启动失败
# ADMIN_PASSWORD=admin123


# ================================================================
# AI Provider
# ================================================================
#
# 三个 Provider 独立选择，缺省均为 mock —— 无需任何凭据即可启动，
# 适合本地开发与前端联调。
#
# 选择 qwen / baai 时，下方对应的 API Key 必填，否则启动时报错退出。

# LLM：qwen | mock
LLM_PROVIDER=mock

# Embedding：baai | mock
EMBEDDING_PROVIDER=mock

# Reranker：baai | mock
RERANKER_PROVIDER=mock

# ---- 阿里云 Qwen（LLM_PROVIDER=qwen 时必填）----
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM 使用的模型名称。默认 qwen-plus
QWEN_MODEL=qwen-plus

# ---- 网页采集 ----
# 抓取网页时发送的 User-Agent。留空使用内置默认值；
# 后台「系统配置 → collector.user_agent」可覆盖此值并热生效。
COLLECTOR_USER_AGENT=AiKnow/1.0 (Internal Knowledge Base)

# ---- BAAI（EMBEDDING_PROVIDER 或 RERANKER_PROVIDER = baai 时必填）----
# Embedding 与 Reranker 共用同一组凭据
BAAI_API_KEY=
BAAI_BASE_URL=https://api.deepinfra.com/v1


# ================================================================
#
# 说明：本文件中的每一项都会被应用读取。
#
# 端口映射不再需要单独变量 —— compose 下宿主机与容器使用同一端口，
# 由上方的 PORT 与 POSTGRES_PORT 统一控制。
#
# 监听地址也不再配置：容器端口默认发布在所有网卡上，访问控制交由网络层
# （安全组 / 防火墙 / 反向代理）负责，详见 docs/DEPLOY.md 第八章。
# ================================================================
