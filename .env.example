# AiKnow 环境配置示例
#
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
#
# 优先级：环境变量 > .env > config.yaml > 内置默认值
#
# 只列出确实生效的变量。L2 业务配置（检索权重、分块大小、LLM 温度等）
# 存放在数据库 settings 表中，由后台管理界面调整并热生效，不在此处配置。


# ================================================================
# 数据库连接
# ================================================================
#
# 两种方式，**二选一**：
#
#   方式 1  DATABASE_URL          —— 直跑二进制（本地开发 / 生产）
#   方式 2  POSTGRES_* 分项       —— docker compose
#
# DATABASE_URL 优先：填了它就忽略下面的分项。
#
# compose 部署下本文件里的 DATABASE_URL 会被编排显式置空（它通常指向
# 127.0.0.1，在容器内是容器自己），因此两者可以并存于同一份 .env，
# 各自在对应部署形态下生效，不会互相干扰。

# ---- 方式 1：直跑二进制 ----
# 注释掉或留空则改用下方分项
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/aiknow?sslmode=disable

# ---- 方式 2：docker compose ----
# compose 下这组值有两个用途：建库（postgres 服务），以及由应用拼装连接串。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=aiknow

# 直跑二进制时若想改用分项（而非 DATABASE_URL），还需设置：
# POSTGRES_HOST=127.0.0.1   # 默认 postgres（compose 服务名）
# POSTGRES_PORT=5432        # 宿主机 5432 已被占用时改这里
# POSTGRES_SSLMODE=disable  # 默认 disable


# ================================================================
# 服务器
# ================================================================

# 应用监听端口（容器内端口 / 直跑时的本机端口）。默认 8080。
PORT=8080

# 运行环境：development | production。默认 development。
#
# 设为 production 时：
#   - 禁止使用明文 ADMIN_PASSWORD，必须提供 ADMIN_PASSWORD_HASH，否则启动失败
#   - Session Cookie 启用 Secure 标记（仅 HTTPS 传输）
#
# 注意：本地通过 HTTP 访问时不要设为 production，否则浏览器不会回传 Cookie，
#       将无法登录。
APP_ENV=development


# ================================================================
# 会话与管理员
# ================================================================

# Session 密钥，至少 32 个字符，生产环境务必改为随机串。
#
# 当前状态：配置校验会强制要求本项且检查长度，但代码尚未实际使用它
# （Session ID 由密码学随机源生成并在服务端存储，暂不需要签名密钥）。
# 保留为必填是为了在引入 CSRF Token / Cookie 签名前就把它准备好。
#
# 生成方式：openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Session 有效期，同时作为 Cookie 的 MaxAge。默认 24h。
# 格式为 Go 时长字符串：30m / 12h / 168h
SESSION_LIFETIME=24h

# 管理员用户名。默认 admin。
ADMIN_USERNAME=admin

# 管理员密码，以下两项**至少提供一个**；同时存在时以 HASH 为准。

# 方式 1：bcrypt 哈希（生产环境必须用这个）
# 生成命令：go run ./cmd/aiknow-server hashpwd 你的密码
ADMIN_PASSWORD_HASH=

# 方式 2：明文密码（仅开发环境；启动时在内存中哈希，不落盘）
# APP_ENV=production 时填写此项会导致启动失败
# ADMIN_PASSWORD=admin123


# ================================================================
# AI Provider
# ================================================================
#
# 三个 Provider 独立选择，缺省均为 mock —— 无需任何凭据即可启动，
# 适合本地开发与前端联调。
#
# 选择 qwen / baai 时，下方对应的 API Key 必填，否则启动时报错退出。

# LLM：qwen | mock
LLM_PROVIDER=mock

# Embedding：baai | mock
EMBEDDING_PROVIDER=mock

# Reranker：baai | mock
RERANKER_PROVIDER=mock

# ---- 阿里云 Qwen（LLM_PROVIDER=qwen 时必填）----
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM 使用的模型名称。默认 qwen-plus
QWEN_MODEL=qwen-plus

# ---- BAAI（EMBEDDING_PROVIDER 或 RERANKER_PROVIDER = baai 时必填）----
# Embedding 与 Reranker 共用同一组凭据
BAAI_API_KEY=
# base_url 末尾不带 /v1；provider 内部会拼 /v1/embeddings / /v1/rerank
BAAI_BASE_URL=https://api.deepinfra.com
# Embedding 与 Reranker 模型名留空时使用内置默认
BAAI_EMBEDDING_MODEL=
BAAI_RERANKER_MODEL=

# ---- 网页采集 ----
# 超时、重定向、最小内容长度属 L1 启动配置（http.Client 启动时创建，需重启生效）。
# User-Agent 例外：后台「系统配置 → collector.user_agent」可覆盖并热生效。
# 抓取超时。默认 10s
# COLLECTOR_TIMEOUT=10s
# 最大重定向次数。默认 3
# COLLECTOR_MAX_REDIRECTS=3
# 最小内容长度（字符），低于此长度视为采集失败。默认 200
# COLLECTOR_MIN_CONTENT_LENGTH=200
# 抓取网页时发送的 User-Agent。默认如下；
# 后台「系统配置 → collector.user_agent」可覆盖此值并热生效。
COLLECTOR_USER_AGENT=Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1

# ---- 无头浏览器渲染（渲染优先，http 兜底）----
# 渲染优先：需 COLLECTOR_BROWSER_ENABLED=true 且 COLLECTOR_BROWSER_ENDPOINT 非空
# 才真正走浏览器；否则采集退化为纯 http，无需部署浏览器。
# 浏览器独立部署（browserless），见 deploy/browserless/ 下的 compose 与说明。
#
# 总开关。默认 false（关闭）
COLLECTOR_BROWSER_ENABLED=false
# browserless 端点，如 http://1.2.3.4:3000。留空则渲染关闭
COLLECTOR_BROWSER_ENDPOINT=
# browserless 访问令牌
COLLECTOR_BROWSER_TOKEN=
# 单页渲染硬超时（含导航、等待、截图全程）。默认 30s。
# 子超时按其缩放：导航 = 此值-2s；等网络空闲/等图片 = 此值/3（下限 3s）。
# 图片多的长文页可适当调大（如 60s）。
COLLECTOR_BROWSER_TIMEOUT=30s

# ---- 腾讯云 COS（采集文章截图归档，防源站失效）----
# URL 采集的文章在渲染时顺带截全页图并上传 COS。下列任一缺失则截图归档整体
# 关闭（不影响正文采集）。凭据建议仅放此处，勿写入 config.yaml。
COS_SECRET_ID=
COS_SECRET_KEY=
# 存储桶名（含 appid 后缀），如 aiknow-1300000000
COS_BUCKET=
# 地域，如 ap-guangzhou
COS_REGION=
# 自定义访问域名（CDN）；留空用 COS 默认域名
COS_ENDPOINT=
# 正文图片归档：把文章里的外链图片（公众号图床有防盗链）下载进 COS 并替换链接。
# 需上面的 COS 配置完整；关闭后正文保留原始外链（后台预览可能显示坏图）。
COLLECTOR_ARCHIVE_IMAGES=true
# 对象键前缀。默认 screenshots
COS_PATH_PREFIX=aiknow

# ---- 文件传输助手通道（只收转发来的公众号文章）----
# 走网页版协议（逆向）：手机把公众号文章转发给「文件传输助手」，服务端收下链接入库。
# 先用 `aiknow-server wechatweb login` 扫码，凭据会加密存库（密钥由 SESSION_SECRET 派生）。
# 注意：开启后不要再开网页版文件传输助手，两个消费者会抢消息。
WECHATWEB_ENABLED=false

# ---- 微信 iLink Bot（可选个人号入口）----
# 开启后 serve 启动长轮询：发链接即采集、发关键词即检索。详见 docs/WEIXIN_BOT.md。
# 凭据（bot_token）与消费游标不在这里：扫码后由 `aiknow-server weixin login`
# 写入 weixin_bot_accounts 表，避免凭据进 git / 备份。
WEIXIN_BOT_ENABLED=false
# 服务端域名，留空用官方 https://ilinkai.weixin.qq.com
WEIXIN_BOT_BASE_URL=

# ================================================================
#
# 说明：本文件中的每一项都会被应用读取。
#
# 端口映射不再需要单独变量 —— compose 下宿主机与容器使用同一端口，
# 由上方的 PORT 与 POSTGRES_PORT 统一控制。
#
# 监听地址也不再配置：容器端口默认发布在所有网卡上，访问控制交由网络层
# （安全组 / 防火墙 / 反向代理）负责，详见 docs/DEPLOY.md 第八章。
# ================================================================
