# AiKnow 环境配置示例
#
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
#
# 优先级：环境变量 > .env > config.yaml > 内置默认值
#
# 本文件按 **消费方** 分区：
#   [A] 应用读取     —— 直跑二进制与 compose 部署都生效
#   [B] 仅 compose   —— 只被 docker-compose.yml 用于文件内插值，应用不读取
#
# 只列出确实生效的变量。L2 业务配置（检索权重、分块大小、LLM 温度等）
# 存放在数据库 settings 表中，由后台管理界面调整并热生效，不在此处配置。


# ================================================================
# [A] 数据库连接（应用读取）
# ================================================================

# 直跑二进制时必填。
#
# docker compose 部署时**请留空或忽略此项**：编排会用下方 POSTGRES_* 按服务名
# 现场拼装连接串并注入容器，此处填写的值不会被传入。
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/aiknow?sslmode=disable


# ================================================================
# [A] 服务器（应用读取）
# ================================================================

# 应用监听端口（容器内端口 / 直跑时的本机端口）。默认 8080。
PORT=8080

# 运行环境：development | production。默认 development。
#
# 设为 production 时：
#   - 禁止使用明文 ADMIN_PASSWORD，必须提供 ADMIN_PASSWORD_HASH，否则启动失败
#   - Session Cookie 启用 Secure 标记（仅 HTTPS 传输）
#
# 注意：本地通过 HTTP 访问时不要设为 production，否则浏览器不会回传 Cookie，
#       将无法登录。
APP_ENV=development


# ================================================================
# [A] 会话与管理员（应用读取）
# ================================================================

# Session 密钥，至少 32 个字符，生产环境务必改为随机串。
#
# 当前状态：配置校验会强制要求本项且检查长度，但代码尚未实际使用它
# （Session ID 由密码学随机源生成并在服务端存储，暂不需要签名密钥）。
# 保留为必填是为了在引入 CSRF Token / Cookie 签名前就把它准备好。
#
# 生成方式：openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Session 有效期，同时作为 Cookie 的 MaxAge。默认 24h。
# 格式为 Go 时长字符串：30m / 12h / 168h
SESSION_LIFETIME=24h

# 管理员用户名。默认 admin。
ADMIN_USERNAME=admin

# 管理员密码，以下两项**至少提供一个**；同时存在时以 HASH 为准。

# 方式 1：bcrypt 哈希（生产环境必须用这个）
# 生成命令：go run ./cmd/aiknow-server hashpwd 你的密码
ADMIN_PASSWORD_HASH=

# 方式 2：明文密码（仅开发环境；启动时在内存中哈希，不落盘）
# APP_ENV=production 时填写此项会导致启动失败
# ADMIN_PASSWORD=admin123


# ================================================================
# [A] AI Provider（应用读取）
# ================================================================

# 三个 Provider 独选择，缺省均为 mock —— 无需任何凭据即可启动，
# 适合本地开发与前端联调。
#
# 选择 qwen / baai 时，下方对应的 API Key 必填，否则启动时报错退出。

# LLM：qwen | mock
LLM_PROVIDER=mock

# Embedding：baai | mock
EMBEDDING_PROVIDER=mock

# Reranker：baai | mock
RERANKER_PROVIDER=mock

# ---- 阿里云 Qwen（LLM_PROVIDER=qwen 时必填）----
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- BAAI（EMBEDDING_PROVIDER 或 RERANKER_PROVIDER = baai 时必填）----
# Embedding 与 Reranker 共用同一组凭据
BAAI_API_KEY=
BAAI_BASE_URL=https://api.deepinfra.com/v1


# ================================================================
# [B] 仅 docker compose 使用（应用不读取）
# ================================================================
#
# 以下变量只在 docker-compose.yml 内做插值，不会作为配置项被应用读取。
# 直跑二进制时可全部忽略。

# ---- 数据库容器 ----
# 用于建库，同时用于拼装注入应用容器的 DATABASE_URL
POSTGRES_USER=postgres
# 必填，compose 启动时未设置会直接报错
POSTGRES_PASSWORD=
POSTGRES_DB=aiknow

# ---- 端口映射（宿主机侧）----
# 数据库默认仅监听回环地址，避免暴露到公网；
# 需从其他主机连入时改为 0.0.0.0，并自行确保网络层已有防护
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# 应用在宿主机上的监听地址与端口。
# 注意与上方 [A] 区的 PORT 区分：PORT 是容器内应用监听的端口，
# APP_PORT 是映射到宿主机的端口，两者可以不同。
APP_BIND=0.0.0.0
APP_PORT=8080
