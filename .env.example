# AiKnow 环境配置
# 复制此文件为 .env 并填写实际值

# ========================================
# 数据库配置（必填）
# ========================================
# 直接运行二进制时使用；docker compose 部署时此项由编排自动拼装，无需设置
DATABASE_URL=postgres://postgres:password@192.168.1.234:5432/aiknow?sslmode=disable

# ---- 以下仅 docker compose 部署时需要 ----
# 数据库容器的账号与密码（POSTGRES_PASSWORD 必填）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=aiknow
# 数据库端口映射，默认仅监听回环地址，避免暴露到公网
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
# 应用端口映射
APP_BIND=0.0.0.0
APP_PORT=8080

# ========================================
# AI 服务配置（必填）
# ========================================
QWEN_API_KEY=your_qwen_api_key_here
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

BAAI_API_KEY=your_baai_api_key_here
BAAI_BASE_URL=https://api.deepinfra.com/v1

# ========================================
# 服务器配置
# ========================================
PORT=8080
APP_ENV=development

# ========================================
# 会话配置（必填）
# ========================================
SESSION_SECRET=your-random-secret-key-at-least-32-characters-long

# ========================================
# 管理员配置（必填，二选一）
# ========================================
# 方式 1：密码哈希（推荐生产环境）
# 生成命令：./aiknow hashpwd your_password
ADMIN_PASSWORD_HASH=

# 方式 2：明文密码（仅开发环境）
# ADMIN_PASSWORD=admin123
